<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>$(AetherfitVersion)</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PackageProjectUrl>https://github.com/Kussie/Aetherfit</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IconUrl>https://raw.githubusercontent.com/Kussie/Aetherfit/master/Data/icon-square.png</IconUrl>
    <IsPackable>false</IsPackable>
    <!-- Points the build-time license check at the source file directly - the Content item below
         also copies it to bin/, which would otherwise give the default recursive search two matches. -->
    <SixLaborsLicenseFile Condition="Exists('$(MSBuildProjectDirectory)\sixlabors.lic')">$(MSBuildProjectDirectory)\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Data\icon-square.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <EmbeddedResource Include="Resources\composite_tags.json">
      <LogicalName>Aetherfit.composite_tags.json</LogicalName>
    </EmbeddedResource>
    <!-- SixLabors validates its license at runtime too, not just at build time - the file has to
         ship next to the plugin DLL, not just sit in the project tree. Gitignored; see .gitignore. -->
    <Content Include="sixlabors.lic" Condition="Exists('sixlabors.lic')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.31.1" />
    <PackageReference Include="PDFsharp" Version="6.5.0" />
    <!-- Pins PDFsharp's transitive Pkcs dep past its known DoS CVEs (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glamourer.Api\Glamourer.Api.csproj" />
    <ProjectReference Include="..\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Penumbra.GameData\Penumbra.GameData.csproj" />
  </ItemGroup>
</Project>
